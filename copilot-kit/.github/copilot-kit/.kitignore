# Directories the scout guard keeps the agent from reading or scanning,
# because their file counts flood the model context.
# One directory name per line. Prefix with ! to allow a default again.

# JS/TS
node_modules
dist
build
.next
.nuxt

# Python
__pycache__
.venv
venv

# Go/PHP/Rust/Java
vendor
target

# VCS and coverage
.git
coverage
